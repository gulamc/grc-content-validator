# Local dev/test artifacts (not for repo or deployment).
# Exception: production-grade verification harness — imports the real
# RULE_FNS map from app/gn-validator/rules/index.ts and runs the full
# rule set against the committed sample fixtures. Required for proving
# byte-identical regression behaviour before any deploy.
scripts/*
!scripts/verify-full-prod-rules.mjs
!scripts/verify-deliverable.mjs
!scripts/snapshot-full.mjs
!scripts/verify-anchor-correctness.mjs
!scripts/verify-rule-conformance.mjs
!scripts/verify-spec-implementation.mjs
!scripts/verify-identifier-findability.mjs
!scripts/verify-b1-predicate.mjs
!scripts/verify-b1-fixture-abcd.mjs
!scripts/verify-req1-fixture-abcd.mjs
!scripts/parse-rqf-template.mjs

# Regenerated by verify-*-fixture-abcd.mjs scripts; the input fixture
# is the regression artifact, not the per-run output.
samples/fixtures/*-output.docx
tsconfig.tsbuildinfo
